{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forward Flow",
  "version": "0.2.0",
  "identifier": "com.karangoel59.forward-flow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Forward Flow",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "fullscreen": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#12110F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
